---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import OpensInNewTab from "../components/OpensInNewTab.astro";
import {
  fetchOrgTopContributors,
  formatGithubContributions,
} from "../lib/github-org-contributors";

let contributors: Awaited<ReturnType<typeof fetchOrgTopContributors>> = [];
let loadError: string | null = null;

try {
  contributors = await fetchOrgTopContributors(24);
} catch {
  loadError = "We couldn't load contributors from GitHub during the last build.";
}
---

<Layout
  title="People"
  description="These are the students who build Geary, the GWA Calculator, Room TBA and the rest of bulsu.tools."
>
  <Header />
  <main id="main-content" class="people-main">
    <div class="container people-container">
      <a href="/" class="people-back">&larr; Home</a>

      <header class="people-hero">
        <h1>The team</h1>
        <p class="people-lede">
          bulsu.tools is built by BulSU students in their spare time. Everyone
          on this page shipped something that people use.
        </p>
      </header>

      <section class="people-section" aria-labelledby="contributors-heading">
        <h2 id="contributors-heading">Contributors</h2>
        {
          loadError ? (
            <p class="people-note" role="alert">{loadError}</p>
          ) : contributors.length === 0 ? (
            <p class="people-note" role="status">
              We haven't found any public contributors yet. Check back after the
              next deploy.
            </p>
          ) : (
            <ul class="contributor-list">
              {contributors.map((person) => {
                const displayName = person.name ?? person.login;
                const commits = formatGithubContributions(person.contributions);
                return (
                  <li>
                    <a
                      class="contributor-list__name"
                      href={person.profileUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {displayName}
                      <OpensInNewTab />
                    </a>
                    <span class="contributor-list__count">{commits}</span>
                  </li>
                );
              })}
            </ul>
          )
        }
        <p class="people-note">
          This list comes straight from GitHub: commits across the public
          bulsutools repositories, bots filtered out.
        </p>
      </section>

      <section class="people-section" aria-labelledby="join-heading">
        <h2 id="join-heading">Want your name here?</h2>
        <p>
          The good-first-issue queue is open and you don't need to be a strong
          programmer to start. Guide fixes, map data corrections and design
          feedback all count.
        </p>
        <p class="people-links">
          <a href="https://github.com/bulsutools">GitHub organization</a>
          <a href="https://github.com/bulsutools/geary/issues">Geary issues</a>
          <a href="https://github.com/bulsutools/room-tba/issues">Room TBA issues</a>
        </p>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .people-main {
    min-height: 100vh;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .people-container {
    max-width: 56rem;
  }

  .people-back {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 2rem;
  }

  .people-back:hover {
    color: var(--brand-maroon);
  }

  .people-hero h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin: 0 0 1rem;
  }

  .people-lede {
    margin: 0 0 3rem;
    font-size: 0.95rem;
    max-width: 42rem;
  }

  .people-section {
    margin-bottom: 3.5rem;
  }

  .people-section h2 {
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }

  .people-section p {
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  .people-note {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .contributor-list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  }

  .contributor-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.85rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border-card);
  }

  .contributor-list__name {
    color: var(--brand-maroon);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 600;
  }

  .contributor-list__count {
    color: var(--text-muted);
    white-space: nowrap;
  }

  .people-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .people-links a {
    color: var(--brand-maroon);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-size: 0.9rem;
  }
</style>
