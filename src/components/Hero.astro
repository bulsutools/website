---
import OpensInNewTab from "./OpensInNewTab.astro";
---

<section class="hero-section" aria-labelledby="hero-title">
  <img
    class="hero-mark"
    src="/logo.svg"
    alt=""
    fetchpriority="high"
    width="512"
    height="512"
    aria-hidden="true"
  />

  <div class="container hero-container">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title">
        Free, open-source tools for BulSU students
      </h1>
      <p class="hero-lede">
        Geary is the handbook. The GWA Calculator and Room TBA cover grades and
        campus wayfinding.
      </p>
      <p class="hero-sub">
        Everything is built and run by BulSU students. There are no accounts and
        no tracking, and the code is on GitHub.
      </p>
      <div class="hero-actions">
        <a
          href="https://geary.bulsu.tools"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Open Geary
          <OpensInNewTab />
        </a>
        <a href="#tools" class="btn btn-secondary">See all tools</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    isolation: isolate;
    /* Clears the transparent header that floats over this section. */
    padding: calc(var(--header-height, 3.5rem) + 3.5rem) 0 4rem;
    overflow: hidden;
    background: var(--brand-maroon-deep);
  }

  .hero-mark {
    position: absolute;
    top: 50%;
    right: -10rem;
    width: min(46rem, 85vw);
    height: auto;
    transform: translateY(-55%);
    opacity: 0.28;
    z-index: -1;
    user-select: none;
    pointer-events: none;
  }

  .hero-container {
    position: relative;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 38rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    line-height: 1.05;
    font-weight: 800;
    color: #fff;
    text-wrap: balance;
  }

  .hero-lede {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    line-height: 1.4;
    color: hsl(35 100% 92%);
    font-weight: 600;
    text-wrap: balance;
  }

  .hero-sub {
    font-size: 1rem;
    max-width: 34rem;
    color: hsl(0 0% 100% / 0.94);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .hero-actions :global(.btn-secondary) {
    color: #fff;
    border-color: hsl(0 0% 100% / 0.75);
    background: hsl(0 0% 100% / 0.1);
    backdrop-filter: blur(2px);
  }

  .hero-actions :global(.btn-secondary:hover) {
    background: hsl(0 0% 100% / 0.2);
    border-color: #fff;
  }

  @media (max-width: 48rem) {
    .hero-mark {
      right: -16rem;
      opacity: 0.18;
    }
  }

  @media (min-width: 62rem) {
    .hero-section {
      padding: calc(var(--header-height, 3.5rem) + 5rem) 0 5.5rem;
    }
  }
</style>
